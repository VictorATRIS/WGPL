<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FEFF"
    android:padding="20dp"
    android:orientation="vertical">

    <!-- Título del módulo -->
    <TextView
        android:id="@+id/txtNamemodule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFCF58"
        android:elevation="6dp"
        android:gravity="center"
        android:padding="20dp"
        android:text="🔍 Reinspection"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Card principal con datos -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        android:backgroundTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Campo Location -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Location"
                android:textColor="#041F8E"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editTextArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter location"
                android:background="@android:drawable/edit_text"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- Campo Master -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔢 Master"
                android:textColor="#041F8E"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editTextMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter master code"
                android:background="@android:drawable/edit_text"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="16sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 🔽 Scroll solo en la tabla -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:fillViewport="true">

        <TableLayout
            android:id="@+id/tableDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="12dp"
            android:stretchColumns="*">

            <!-- Encabezado -->
            <TableRow>
                <TextView
                    android:text="Área"
                    android:textStyle="bold"
                    android:textColor="#041F8E"
                    android:padding="8dp"/>
                <TextView
                    android:text="Master"
                    android:textStyle="bold"
                    android:textColor="#041F8E"
                    android:padding="8dp"/>
                <TextView
                    android:text="Estatus"
                    android:textStyle="bold"
                    android:textColor="#041F8E"
                    android:padding="8dp"/>
            </TableRow>

        </TableLayout>
    </ScrollView>
</LinearLayout>