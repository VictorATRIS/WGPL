<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4FEFF">

    <!-- Encabezado moderno -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@drawable/bg_header_gradient_change"
        android:gravity="center">

        <TextView
            android:id="@+id/txtNamemodule"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="🔁 Replace Master"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Card principal con datos -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Campo Old Master -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔁 Old Master"
                android:textColor="#1565C0"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editTextOldMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter old master code"
                android:background="@drawable/bg_edittext"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <!-- Campo New Master -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🆕 New Master"
                android:textColor="#1565C0"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editTextNewMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter new master code"
                android:background="@drawable/bg_edittext"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <!-- Botón de confirmación -->
            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Confirm Replacement"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:padding="12dp"
                android:elevation="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Separador visual -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#CCCCCC" />

    <!-- Mensaje dinámico -->
    <TextView
        android:id="@+id/lbl_linea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:gravity="start"
        android:text=""
        android:textColor="#2F3FD3"
        android:textSize="16sp"
        android:textStyle="italic" />

    <!-- Barra de progreso -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:layout_marginTop="8dp"/>
</LinearLayout>