<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4FEFF"
    android:padding="20dp">

    <!-- Título del módulo -->
    <TextView
        android:id="@+id/txtNamemodule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#7E57C2"
        android:elevation="6dp"
        android:gravity="center"
        android:padding="20dp"
        android:text="🔁 Replace master"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Card principal con datos -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        android:backgroundTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Campo Old Master -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔁 Old Master"
                android:textColor="#041F8E"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editTextOldMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter old master code"
                android:background="@android:drawable/edit_text"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- Campo New Master -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🆕 New Master"
                android:textColor="#041F8E"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/editTextNewMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter new master code"
                android:background="@android:drawable/edit_text"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- Botón de confirmación -->
            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ Confirm Replacement"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#041F8E"
                android:padding="12dp"
                android:elevation="4dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Separador visual -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="#CCCCCC" />

    <!-- Mensaje dinámico -->
    <TextView
        android:id="@+id/lbl_linea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="start"
        android:text=""
        android:textColor="#2F3FD3"
        android:textSize="18sp"
        android:textStyle="italic" />

    <!-- Barra de progreso -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:layout_marginTop="12dp"/>
</LinearLayout>