<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4FEFF"
    android:padding="12dp">

    <!-- Título del módulo -->
    <TextView
        android:id="@+id/txtNamemodule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#7E57C2"
        android:elevation="4dp"
        android:gravity="center"
        android:padding="14dp"
        android:text="🔄 Sort Request"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Card principal con datos -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        android:backgroundTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Campo QR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📎 QR"
                android:textColor="#7E57C2"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="2dp"/>

            <EditText
                android:id="@+id/editTextMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Scan or enter QR"
                android:background="@android:drawable/edit_text"
                android:inputType="text"
                android:padding="8dp"
                android:textColor="#000000"
                android:textSize="14sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scroll vertical -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:fillViewport="true">

        <!-- Scroll horizontal -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal">

            <TableLayout
                android:id="@+id/tableSortRequest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:padding="12dp">

                <!-- Encabezado -->
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#D1C4E9"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:text="Sort Request Detail"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:padding="6dp"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Value"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:padding="6dp"
                        android:textSize="14sp"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </TableRow>



            </TableLayout>
        </HorizontalScrollView>
    </ScrollView>

</LinearLayout>