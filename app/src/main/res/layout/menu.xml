<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    tools:context=".MainLogin">

    <!-- Encabezado -->
    <TextView
        android:id="@+id/textUsuario2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#143FA4"
        android:padding="20dp"
        android:text="📋 Menu"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Pallet Storage -->
    <Button
        android:id="@+id/btnEnvio"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_margin="12dp"
        android:backgroundTint="#FFFFFF"
        android:foreground="?android:attr/selectableItemBackground"
        android:elevation="6dp"
        android:text="📦\nPallet Storage"
        android:textAlignment="center"
        android:textColor="#143FA4"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/textUsuario2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Reinspection -->
    <Button
        android:id="@+id/btnEmbarque"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_margin="12dp"
        android:backgroundTint="#FFFFFF"
        android:foreground="?android:attr/selectableItemBackground"
        android:elevation="6dp"
        android:text="🔍\nReinspection"
        android:textAlignment="center"
        android:textColor="#2C3E50"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnEnvio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Shipping -->
    <Button
        android:id="@+id/btnShipping"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_margin="12dp"
        android:backgroundTint="#FFFFFF"
        android:foreground="?android:attr/selectableItemBackground"
        android:elevation="6dp"
        android:text="📤\nShipping"
        android:textAlignment="center"
        android:textColor="#0D47A1"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnEmbarque"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Delete -->
    <Button
        android:id="@+id/btnRetorno"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_margin="12dp"
        android:backgroundTint="#FFFFFF"
        android:foreground="?android:attr/selectableItemBackground"
        android:elevation="6dp"
        android:text="🗑️\nDelete"
        android:textAlignment="center"
        android:textColor="#E53935"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnShipping"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Logo centrado abajo -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/logo_logintns"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Botón cerrar arriba -->
    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="8dp"
        android:src="@drawable/cerrarr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>