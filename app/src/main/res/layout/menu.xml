<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FEFF"
    tools:context=".MainLogin">

    <!-- Encabezado moderno -->
    <FrameLayout
        android:id="@+id/headerMenu"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:background="@drawable/bg_header_gradient_wh"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textUsuario2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📋 Menu"
            android:textColor="#fff"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <!-- Botón Pallet Storage -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPalletStorage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnEnvio"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="📦\nPallet Storage"
            android:textColor="#143FA4"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Reinspection -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardReinspection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardPalletStorage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnEmbarque"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="🔍\nReinspection"
            android:textColor="#2C3E50"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Pick Up -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPickUp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardReinspection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnShipping"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="📤\nPick Up"
            android:textColor="#0D47A1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Shipping -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardShipping"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardPickUp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnShippingExtra"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="🚚\nShipping"
            android:textColor="#1E88E5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Inventory Quantity -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardInventoryQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardShipping"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnInventoryQuantity"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="📊\nPhysical Inventory"
            android:textColor="#00695C"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Delete -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDelete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardInventoryQuantity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnRetorno"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="🗑️\nDelete"
            android:textColor="#E53935"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Logo centrado abajo -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="80dp"
        android:layout_height="45dp"
        android:scaleType="centerInside"
        android:src="@drawable/logo_logintns"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>