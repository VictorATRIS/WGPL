<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FEFF"
    tools:context=".MainLogin">

    <!-- Encabezado moderno -->
    <FrameLayout
        android:id="@+id/headerMenu"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:background="@drawable/bg_header_gradient_qa_menu"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textUsuario2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="📋 Menu"
            android:textColor="#242323"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <!-- Botón Recived -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRecived"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/headerMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnEnvio"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="📦\nRecived"
            android:textColor="#143FA4"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Return Master -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardReturnMaster"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardRecived"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnEmbarque"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="🔁\nReturn Master"
            android:textColor="#2C3E50"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Sort Request -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSortRequest"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardReturnMaster"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSortRequest"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="🧮\nSort Request"
            android:textColor="#FBA664"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Replace Master -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardReplaceMaster"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cardSortRequest"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnRemplaceMaster"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="🔁\nReplace Master"
            android:textColor="#041F8E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Logo centrado abajo -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="80dp"
        android:layout_height="45dp"
        android:scaleType="centerInside"
        android:src="@drawable/logo_logintns"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>