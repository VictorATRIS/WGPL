<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layout principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F4FEFF"
        android:padding="12dp">

        <!-- Título del módulo -->
        <TextView
            android:id="@+id/txtNamemodule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#57C26E"
            android:elevation="4dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="📦 Shipping Instructions"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Card principal con datos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Label de totales -->
                    <TextView
                        android:id="@+id/lblTotales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total pallets: 0"
                        android:textColor="#388E3C"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:layout_marginBottom="8dp"/>

                    <!-- Campo Área -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Location"
                        android:textColor="#388E3C"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="2dp"/>

                    <EditText
                        android:id="@+id/editTextArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter area"
                        android:background="@android:drawable/edit_text"
                        android:inputType="text"
                        android:padding="8dp"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Campo Master -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔢 Master"
                        android:textColor="#388E3C"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="2dp"/>

                    <EditText
                        android:id="@+id/editTextMasterCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter master code"
                        android:background="@android:drawable/edit_text"
                        android:inputType="text"
                        android:padding="8dp"
                        android:textColor="#000000"
                        android:textSize="14sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Encabezado fijo separado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#4EE0EB"
            android:padding="8dp"
            android:elevation="4dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Área"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Master"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Estatus"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scroll para las filas -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="4dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TableLayout
                android:id="@+id/tableDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:padding="12dp">

            </TableLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Botón flotante “Close” -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCloseFloat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Close"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:backgroundTint="#57C26E" />
</FrameLayout>